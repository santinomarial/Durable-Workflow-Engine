DATABASE_URL=postgresql://durable:durable@localhost:5432/durable
# Every secret also supports a mutually exclusive *_FILE form for container
# secret mounts, for example DATABASE_URL_FILE=/run/secrets/database_url.
# Development only. Production defaults to fail-closed authentication and must
# configure DWE_API_KEYS as documented in docs/security.md.
DWE_AUTH_MODE=disabled
DWE_RATE_LIMIT_PER_MINUTE=300
DWE_MAX_REQUEST_BYTES=1048576
DWE_HEALTH_TIMEOUT_SECONDS=2
DWE_LOG_FORMAT=json
LOG_LEVEL=INFO
DWE_DB_POOL_MIN_SIZE=2
DWE_DB_POOL_MAX_SIZE=10
DWE_DB_COMMAND_TIMEOUT_SECONDS=30
DWE_DB_STATEMENT_TIMEOUT_MS=30000
